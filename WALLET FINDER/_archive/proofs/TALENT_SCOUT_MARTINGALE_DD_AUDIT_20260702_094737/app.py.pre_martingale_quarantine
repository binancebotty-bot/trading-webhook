def _selected_true_count(state_obj: dict) -> int:
    selected = state_obj.get("selected", {}) if isinstance(state_obj, dict) else {}
    return sum(1 for v in selected.values() if bool(v)) if isinstance(selected, dict) else 0


def _latest_state_with_selection() -> dict:
    """Recover Talent Scout-owned selection keys from the latest rotating backup."""
    try:
        candidates = sorted(
            STATE_BACKUP_DIR.glob("ui_state_*.json"),
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
    except Exception:
        candidates = []
    for path in candidates:
        try:
            data = json.loads(path.read_text(encoding="utf-8-sig"))
        except Exception:
            continue
        if isinstance(data, dict) and _selected_true_count(data) > 0:
            log.warning("Recovered Talent Scout selection from %s", path.name)
            return data
    return {}


def _save_state():
    """Atomic save: write to temp file, then os.replace() — no partial writes possible.
    Preserves keys owned by other apps (e.g. HL_Copy_App_SSOT.py)."""
    if not _STATE_SAVE_ENABLED:
        log.warning("Skipping ui_state save before state load completed")
        return
    # Read existing file first to preserve keys owned by other apps
    existing = {}
    if STATE_FILE.exists():
        try:
            existing = json.loads(STATE_FILE.read_text(encoding="utf-8-sig"))
            if not isinstance(existing, dict):
                existing = {}
        except Exception:
            existing = {}
    # Never let a startup/reload accident erase a real non-empty selection set.
    # The only intended empty-selection write is the explicit Clear All action.
    incoming_selected_count = _selected_true_count(_state)
    existing_selected_count = _selected_true_count(existing)
    selection_dirty = bool(_state.pop("_selection_dirty", False))
    preserve_existing_selection = (
        incoming_selected_count < existing_selected_count
        and existing_selected_count > 0
        and not selection_dirty
        and not _state.pop("_allow_empty_selection_save", False)
    )
    selected_payload = existing.get("selected", {}) if preserve_existing_selection else _state.get("selected", {})
    order_payload = existing.get("wallet_order", []) if preserve_existing_selection else _state.get("wallet_order", [])
    weights_payload = existing.get("wallet_weights", {}) if preserve_existing_selection else _state.get("wallet_weights", {})

    # Update only keys this app owns; preserve everything else
    existing.update({
        "sort": _state.get("sort"),
        "dir": _state.get("dir"),
        "selected": selected_payload,
        "wallet_order": order_payload,
        "wallet_weights": weights_payload,
        "mode": _state.get("mode"),
        "filters": _state.get("filters"),
        "risk_per_wallet": _state.get("risk_per_wallet"),
        "normalize": _state.get("normalize"),
        "days": _state.get("days"),
        "start_date": _state.get("start_date"),
        "end_date": _state.get("end_date"),
        "hide_dormant": _state.get("hide_dormant", False),
    })
    if "wallet_include" in _state:
        existing["wallet_include"] = _state.get("wallet_include", {})
    payload = json.dumps(existing, indent=2)
    try:
        # Write to temp file in SAME directory (same filesystem = atomic rename)
        fd, tmp_path = tempfile.mkstemp(
            dir=str(BASE_DIR), prefix=".ui_state_", suffix=".tmp"
        )
        try:
            os.write(fd, payload.encode("utf-8"))
            os.fsync(fd)
        finally:
            os.close(fd)
        # Backup previous good copy before overwriting
        if STATE_FILE.exists():
            try:
                BACKUP_FILE = STATE_FILE.with_suffix(".json.bak")
                current_bytes = STATE_FILE.read_bytes()
                BACKUP_FILE.write_bytes(current_bytes)
                STATE_BACKUP_DIR.mkdir(parents=True, exist_ok=True)
                stamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S_%f")
                (STATE_BACKUP_DIR / f"ui_state_{stamp}.json").write_bytes(current_bytes)
            except Exception:
                pass
        # Atomic rename — no reader will ever see a half-written file
        os.replace(tmp_path, str(STATE_FILE))
        log.debug("ui_state saved (%d selected wallets)", _selected_true_count(existing))
    except Exception as exc:
        log.error("FAILED to save ui_state: %s", exc)
        # Last resort: direct write so at least something persists
        try:
            STATE_FILE.write_text(payload, encoding="utf-8")
            log.warning("ui_state saved via fallback direct write")
        except Exception as exc2:
            log.error("CRITICAL: ui_state fallback write also failed: %s", exc2)


def _load_state():
    """Load state from disk. Falls back to .bak if main file is corrupt."""
    global _STATE_SAVE_ENABLED
    backup_file = STATE_FILE.with_suffix(".json.bak")
    for attempt_path in (STATE_FILE, backup_file):
        if not attempt_path.exists():
            continue
        try:
            raw = attempt_path.read_text(encoding="utf-8-sig")
            data = json.loads(raw)
            if not isinstance(data, dict):
                raise ValueError(f"Expected dict, got {type(data).__name__}")
            if _selected_true_count(data) == 0:
                recovered = _latest_state_with_selection()
                if recovered:
                    data["selected"] = recovered.get("selected", {})
                    data["wallet_order"] = recovered.get("wallet_order", [])
                    data["wallet_weights"] = recovered.get("wallet_weights", {})
            _state.update(data)
            selected_count = sum(1 for v in _state.get("selected", {}).values() if v)
            log.info(
                "Loaded ui_state from %s (%d total wallets, %d selected)",
                attempt_path.name,
                len(_state.get("selected", {})),
                selected_count,
            )
            _STATE_SAVE_ENABLED = True
            return
        except Exception as exc:
            log.warning("Failed to load %s: %s", attempt_path.name, exc)
    log.warning("No valid ui_state file found — using defaults")
    _STATE_SAVE_ENABLED = True


atexit.register(_save_state)  # Guarantee save on ANY process exit


